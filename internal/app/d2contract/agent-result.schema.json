{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-taskboard.local/acceptance/schemas/agent-result.schema.json",
  "title": "agent_result input",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "agent_id"],
  "properties": {
    "session_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 256}
  },
  "x-success-output": {
    "type": "object",
    "additionalProperties": false,
    "required": ["ok", "agent_id", "session_id", "state", "result", "usage", "failure_reason"],
    "properties": {
      "ok": {"const": true},
      "agent_id": {"type": "string"},
      "session_id": {"type": "string"},
      "state": {"enum": ["SUCCEEDED", "FAILED", "CANCELLED", "TIMED_OUT", "INTERRUPTED"]},
      "result": {"type": ["object", "array", "string", "number", "boolean", "null"]},
      "usage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requests", "input_tokens", "output_tokens"],
        "properties": {
          "requests": {"type": "integer", "minimum": 0},
          "input_tokens": {"type": ["integer", "null"], "minimum": 0},
          "output_tokens": {"type": ["integer", "null"], "minimum": 0}
        }
      },
      "failure_reason": {"anyOf": [{"$ref": "agent-error.schema.json"}, {"type": "null"}]}
    }
  },
  "x-non-terminal-error": "AGENT_NOT_TERMINAL",
  "x-secret-redacted": true,
  "x-errors": ["AGENT_NOT_FOUND", "AGENT_SESSION_OWNERSHIP_MISMATCH", "AGENT_SESSION_CLOSED", "AGENT_NOT_TERMINAL"],
  "x-contract-version": "D2-v1"
}
