{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-taskboard.local/acceptance/schemas/credential-ref.schema.json",
  "title": "D2 credential_ref",
  "type": "string",
  "minLength": 8,
  "maxLength": 133,
  "pattern": "^cred_[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
  "description": "Opaque AgentDock secure-credential-store identifier. Consumers MUST NOT parse it as secret material or a URL.",
  "x-opaque": true,
  "x-secret-value-forbidden": true,
  "x-contract-version": "D2-v1"
}
